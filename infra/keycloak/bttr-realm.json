{
  "realm": "bttr",
  "enabled": true,
  "displayName": "Bttr",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "passwordPolicy": "length(4) and digits(1) and lowerCase(1) and upperCase(1) and specialChars(1)",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt-BR",
    "en"
  ],
  "defaultLocale": "pt-BR",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@bttr.local",
    "fromDisplayName": "Bttr",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "clients": [
    {
      "clientId": "bttr-server",
      "name": "Bttr Backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "bttr-local-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "bttr-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "bttr-server",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-bttr-server",
      "enabled": true,
      "serviceAccountClientId": "bttr-server",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "bttr-server",
        "roles": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    ]
  }
}
