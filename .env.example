# Copie para .env ao executar ./gradlew quarkusDev.
HTTP_PORT=8000
DATABASE_URL=jdbc:postgresql://localhost:5432/bttr
DATABASE_USERNAME=bttr
DATABASE_PASSWORD=bttr_local
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=bttr
KEYCLOAK_CLIENT_ID=bttr-server
KEYCLOAK_CLIENT_SECRET=bttr-local-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
BTTR_SEED_ENABLED=true
BTTR_SEED_RESET=false
BTTR_SEED_RANDOM_SEED=42
BTTR_SEED_USERS=3
BTTR_SEED_SKILLS_PER_USER=5
BTTR_SEED_ENTRIES_PER_SKILL=20
BTTR_SEED_PASSWORD=!Dev1234
MOCK_API_PORT=8090
